{
  "name": "@0k/geo-map",
  "version": "%%version%%",
  "description": "A host-fed, framework-free map widget (Leaflet 1.9) that shows KMZ / KML / GPX / GeoJSON tracks and places over free basemaps.",
  "keywords": [
    "map",
    "leaflet",
    "kml",
    "kmz",
    "gpx",
    "geojson",
    "openstreetmap"
  ],
  "author": "Valentin Lab <valentin.lab@kalysto.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0k/geo-map.git"
  },
  "homepage": "https://github.com/0k/geo-map",
  "bugs": {
    "url": "https://github.com/0k/geo-map/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./src/index.ts"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/style.css','dist/style.css')\"",
    "prepare": "npm run build",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test:browser": "python3 test/browser.py",
    "check:chrome91": "node scripts/check-chrome91.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run check:chrome91 && npm run demo:build && npm run test:browser"
  },
  "dependencies": {
    "@tmcw/togeojson": "7.1.3",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.8"
  }
}
